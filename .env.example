# The browser API base URL. Use /api/v1 in production so auth cookies stay
# first-party to the frontend domain; Next proxies this to API_PROXY_TARGET.
NEXT_PUBLIC_API_URL=/api/v1

# Backend origin used by Next rewrites. Local default is http://localhost:5050.
API_PROXY_TARGET=http://localhost:5050

# --- White-label (all optional; defaults live in src/config/brand.ts) -------
# NEXT_PUBLIC_BRAND_NAME=Frameloom
# NEXT_PUBLIC_BRAND_DOMAIN=frameloom.app
# NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@frameloom.app
# NEXT_PUBLIC_BRAND_SUPPORT_PHONE=
# Must match the backend's BRAND_COOKIE_PREFIX.
# NEXT_PUBLIC_BRAND_COOKIE_PREFIX=fl
